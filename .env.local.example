# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-project-url

# Must be publishable (sb_publishable_...) or legacy anon JWT — NEVER sb_secret_ (browser/middleware use this).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-only: ingestion bypasses RLS (never NEXT_PUBLIC_, never import in client components)
# Secret key sb_secret_... from Project Settings → API Keys → Secret
SUPABASE_SECRET_KEY=
# Optional legacy JWT if you have not migrated yet:
# SUPABASE_SERVICE_ROLE_KEY=

# Ingestion API (Bearer token for /api/ingestion/*)
INGESTION_API_KEY=generate-a-long-random-string

# ---------------------------------------------------------------------------
# Google Sheets — data intake dashboard (/intake-report)
#
# Read-only service account. Setup:
#   1. GCP console → create a service account → create a JSON key
#   2. Enable the Google Sheets API on that project
#   3. Share BOTH sheets below with the service account's email as Viewer
#      (missing the second one is the usual mistake)
#
# Server-only: never NEXT_PUBLIC_, never import in client components.
# Leave these blank and the dashboard renders setup copy instead of failing.
# ---------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The PEM from the JSON key, on ONE line with literal \n escapes, in quotes:
#   GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=

# Optional — default to the live sheets the n8n workflows use.
# INTAKE_STAGING_SHEET_ID=1z1gVtfZwAIZVzbgp0HQv2pvqg62ca3FdDTb4upY0_9w
# INTAKE_STAGING_TAB=Sheet1
# INTAKE_TICKETS_SHEET_ID=11C6Ev6_swjGRKpiNdnU1_qWsPV3OnHgch83FzOGg4QU
# INTAKE_TICKETS_TAB=Tickets_Current
